set windows-shell := ["powershell.exe", "-NoLogo", "-Command"]

# Pipeline is a library (no entrypoint); "running" it = starting Neo4j (APOC + GDS) and syncing deps.
run:
    uv sync
    docker compose -f pipeline/docker-compose.yml up -d

# --- Tests ---
# Offline (no Neo4j, no API key): test-offline, test-embeddings, test-llm, test-judge.
# Live (calls the Gemini model, counts against its token limits): test-review.
# Extra pytest args work on every recipe, e.g. `just test-llm -k backoff`.

# All offline tests (embeddings, LLM setup, judge). Does not call the LLM.
test-offline *args:
    uv run pytest pipeline/test_pipeline/test_embeddings.py pipeline/test_pipeline/test_llm_setup.py pipeline/test_pipeline/test_llm_judge.py pipeline/test_pipeline/code/modules {{args}}

# Local fastembed embedder: 384 dimensions, rejected providers, ranking. First run downloads the model (about 70 MB).
test-embeddings *args:
    uv run pytest pipeline/test_pipeline/test_embeddings.py {{args}}

# get_llm config parsing, 429 backoff, native structured output.
test-llm *args:
    uv run pytest pipeline/test_pipeline/test_llm_setup.py {{args}}

# LLMJudge: the deepeval judge that routes through the pipeline's LLM instead of OpenAI.
test-judge *args:
    uv run pytest pipeline/test_pipeline/test_llm_judge.py {{args}}

# Code modules (parsing, chunking, rules, review helpers, metrics). Offline, no Neo4j.
test-modules *args:
    uv run pytest pipeline/test_pipeline/code/modules {{args}}

# LLM review on samples/ (vulnerable_app.py, clean_app.py) with the real LLM; -s prints the LLM metrics. Skipped without a model configured.
test-review *args:
    uv run pytest pipeline/test_pipeline/code/test_code_review.py -s {{args}}

# Any test file by path under pipeline/test_pipeline, e.g. `just test-file code/test_code_review.py -k dismissed`.
test-file file *args:
    uv run pytest pipeline/test_pipeline/{{file}} {{args}}

# Accuracy of the vulnerability/bug detector on two sample files, real LLM (costs ~$0.01 per run).
# Extra args: --runs 3 (spread over runs), --rules-only (no LLM), --risky-only.
eval-code *args:
    uv run python -m pipeline.code_analysis.evaluation {{args}}

# eval:
#     uv run pytest pipeline/model_evaluation -s

# --- Migrations (none yet: Neo4j schema/indexes are created at ingest time; add a migrations runner here if needed) ---
# migrate:
#     uv run python -m pipeline.migrations.run
