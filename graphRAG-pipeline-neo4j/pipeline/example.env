# Copy this file to .env and fill in real values.
# graphrag_pipeline_pydantic_ai only reads the variables below — nothing else.

# --- Neo4j connection (required) ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# --- LLM model config (add one line per model you plan to use) ---
# Key format: LLM_MODEL_CONFIG_<key you pass to model=, uppercased, dots -> underscores>
# Value format depends on provider — see README "Supported Models" table.
# [OPENAI-DISABLED] LLM_MODEL_CONFIG_OPENAI_GPT_4_1_MINI=gpt-4.1-mini,sk-your-openai-key
# Google Gemini (key from https://aistudio.google.com/apikey). Value: model_name,api_key
# Key name must contain GEMINI. Check current model IDs / free quotas in AI Studio.
LLM_MODEL_CONFIG_GEMINI_FLASH_LITE=gemini-3.5-flash-lite,your-gemini-api-key
LLM_MODEL_CONFIG_GEMINI_FLASH=gemini-3.5-flash,your-gemini-api-key
# Groq / any OpenAI-compatible endpoint. Value: model_name,base_url,api_key
# LLM_MODEL_CONFIG_GROQ_GPT_OSS_20B=openai/gpt-oss-20b,https://api.groq.com/openai/v1,gsk-your-groq-key
# LLM_MODEL_CONFIG_AZURE_GPT4=deployment_name,https://your-endpoint.openai.azure.com,api_key,2024-02-01

# --- Local embeddings (embedding_provider="local", fastembed; no API key) ---
# Where the ONNX model is cached. Default: system temp folder.
# FASTEMBED_CACHE_DIR=C:/Users/you/.cache/fastembed
# [OPENAI-DISABLED] # --- OpenAI embeddings (required whenever embedding_provider="openai") ---
# [OPENAI-DISABLED] # load_embedding_model() builds the embeddings client from the plain `openai`
# [OPENAI-DISABLED] # SDK, which authenticates via this env var directly — it does NOT reuse the
# [OPENAI-DISABLED] # key embedded in LLM_MODEL_CONFIG_* above. Same key works for both.
# [OPENAI-DISABLED] OPENAI_API_KEY=sk-your-openai-key

# --- Optional tuning (all have sane defaults if unset) ---
# MAX_TOKEN_CHUNK_SIZE=10000
# IS_EMBEDDING=True
# [OPENAI-DISABLED] # GRAPH_CLEANUP_MODEL=openai_gpt_4_1_mini
# GRAPH_CLEANUP_MODEL=gemini_flash_lite
# EFFECTIVE_SEARCH_RATIO=5

# --- Test suite only (graphrag_pipeline_pydantic_ai/test_pipeline/) ---
# [OPENAI-DISABLED] # DEFAULT_TEST_MODEL=openai_gpt_4_1_mini
# DEFAULT_TEST_MODEL=gemini_flash   # query agent + eval judge (default: gemini_flash_lite)
