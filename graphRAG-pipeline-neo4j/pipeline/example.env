# Copy this file to .env and fill in real values.
# graphrag_pipeline_pydantic_ai only reads the variables below — nothing else.

# --- Neo4j connection (required) ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# --- LLM model config (add one line per model you plan to use) ---
# Key format: LLM_MODEL_CONFIG_<key you pass to model=, uppercased, dots -> underscores>
# Value format depends on provider — see README "Supported Models" table.
LLM_MODEL_CONFIG_OPENAI_GPT_4_1_MINI=gpt-4.1-mini,sk-your-openai-key
# LLM_MODEL_CONFIG_AZURE_GPT4=deployment_name,https://your-endpoint.openai.azure.com,api_key,2024-02-01

# --- OpenAI embeddings (required whenever embedding_provider="openai") ---
# load_embedding_model() builds the embeddings client from the plain `openai`
# SDK, which authenticates via this env var directly — it does NOT reuse the
# key embedded in LLM_MODEL_CONFIG_* above. Same key works for both.
OPENAI_API_KEY=sk-your-openai-key

# --- Optional tuning (all have sane defaults if unset) ---
# MAX_TOKEN_CHUNK_SIZE=10000
# IS_EMBEDDING=True
# GRAPH_CLEANUP_MODEL=openai_gpt_4_1_mini
# EFFECTIVE_SEARCH_RATIO=5

# --- Test suite only (graphrag_pipeline_pydantic_ai/test_pipeline/) ---
# DEFAULT_TEST_MODEL=openai_gpt_4_1_mini
